{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "ANTHROPIC_API_KEY",
    "AUTH_SECRET",
    "NEXTAUTH_URL",
    "LLM_PROVIDER",
    "MAX_FILE_SIZE_MB",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "FIO_API_TOKEN",
    "UPLOAD_DIR",
  ],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "dist/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^build"] },
    "format:check": {},
    "format": { "cache": false },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"] },
    // packages/db potřebuje vlastní prisma generate (build) i pro typecheck/lint/test –
    // ^build pokrývá jen závislosti. Klient se generuje do node_modules, kam cache
    // turba nesahá, proto bez cache.
    "@ai-sedlacek/db#build": { "dependsOn": ["^build"], "cache": false },
    "@ai-sedlacek/db#typecheck": { "dependsOn": ["build"] },
    "@ai-sedlacek/db#lint": { "dependsOn": ["build"] },
    "@ai-sedlacek/db#test": { "dependsOn": ["build"] }
  }
}
