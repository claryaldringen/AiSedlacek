{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-review.sh",
            "timeout": 15,
            "onFailure": "block",
            "statusMessage": "Kontrola projektového review před PR"
          }
        ]
      }
    ]
  }
}
